# Copy to .env and fill in. Never commit .env.

# MongoDB (names match the mongo image's own variables)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=bonfire

# API. In Docker, compose passes the Mongo values above to the API as API_MONGO_*.
# Running the API outside Docker: set API_MONGO_USERNAME and API_MONGO_PASSWORD in
# api/.env (same values as above). Without them the API connects without auth.
API_CORS_ORIGINS=http://localhost:5173

# Web (used once web/ exists)
VITE_API_MODE=mock
# Endpoint groups served over HTTP while the rest stay mocked: cards, dice, classes, encounters
VITE_API_HTTP=
VITE_API_BASE_URL=/api/v1
# Base for card image keys (`art`); /images is served from the store's images/ folder
VITE_IMAGE_BASE_URL=/images
# Card data store mounted read-only at /data in the web container (default: sibling folder)
DSTBG_DATA_DIR=../DSTBG_DATA
